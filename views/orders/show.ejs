<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="container page">
  <div class="page-head">
    <div>
      <p class="eyebrow">Order details</p>
      <h1>Order #<%= order.id %></h1>
      <p class="muted">Placed on <%= formatDate(order.created_at) %></p>
    </div>
    <a href="/orders" class="btn btn-ghost">Back to orders</a>
  </div>

  <div class="order-grid">
    <section class="card order-main">
      <div class="order-meta">
        <div>
          <span class="meta-label">Status</span>
          <span class="status status-<%= order.status %>"><%= order.status %></span>
        </div>
        <div>
          <span class="meta-label">Total</span>
          <strong class="order-total"><%= money(order.total) %></strong>
        </div>
        <% if (isAdmin) { %>
          <div>
            <span class="meta-label">Customer</span>
            <strong><%= order.customer_name %></strong>
            <small class="muted"><%= order.customer_email %></small>
          </div>
        <% } %>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Product</th>
              <th>Unit price</th>
              <th>Qty</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(function (item) { %>
              <tr>
                <td><%= item.product_name %></td>
                <td><%= money(item.unit_price) %></td>
                <td><%= item.quantity %></td>
                <td><%= money(item.subtotal) %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr>
              <th colspan="3">Order total</th>
              <th><%= money(order.total) %></th>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>

    <aside class="card order-side">
      <h2>Need something else?</h2>
      <p class="muted">Continue shopping to add more products to a new order.</p>
      <a href="/products" class="btn btn-block">Browse products</a>

      <% if (isAdmin) { %>
        <hr>
        <h2>Update status</h2>
        <% if (order.status === 'cancelled') { %>
          <p class="muted">Cancelled orders cannot be reopened. Stock has been returned to the catalogue.</p>
        <% } else { %>
          <form action="/orders/<%= order.id %>/status" method="post" class="stack">
            <div class="field">
              <label for="status">Order status</label>
              <select id="status" name="status">
                <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Completed</option>
                <option value="cancelled">Cancelled (restocks items)</option>
              </select>
            </div>
            <button type="submit" class="btn btn-block">Save status</button>
          </form>
        <% } %>
      <% } %>
    </aside>
  </div>
</main>

<%- include('../partials/footer') %>
