<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="container page narrow">
  <div class="page-head">
    <div>
      <p class="eyebrow">Admin</p>
      <h1><%= isEdit ? 'Edit product' : 'Add a new product' %></h1>
      <p class="muted"><%= isEdit ? 'Update the details shown to customers.' : 'Fill in the details to publish a product to the catalogue.' %></p>
    </div>
    <a href="/products" class="btn btn-ghost">Back to products</a>
  </div>

  <% if (errors.length > 0) { %>
    <div class="alert alert-error">
      <ul class="alert-list">
        <% errors.forEach(function (message) { %><li><%= message %></li><% }); %>
      </ul>
    </div>
  <% } %>

  <form action="<%= isEdit ? `/products/${product.id}` : '/products' %>" method="post" class="card form-card stack">
    <div class="field">
      <label for="name">Product name</label>
      <input id="name" type="text" name="name" value="<%= product.name || '' %>" maxlength="120" required>
    </div>

    <div class="form-row">
      <div class="field">
        <label for="price">Price (USD)</label>
        <input id="price" type="number" name="price" value="<%= product.price %>" min="0" step="0.01" required>
      </div>
      <div class="field">
        <label for="stock">Stock quantity</label>
        <input id="stock" type="number" name="stock" value="<%= product.stock %>" min="0" step="1" required>
      </div>
    </div>

    <div class="field">
      <label for="image">Product icon</label>
      <input id="image" type="text" name="image" value="<%= product.image || '📦' %>" maxlength="16">
      <small class="hint">Use a single emoji, for example ☕ or 🧊.</small>
    </div>

    <div class="field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4" maxlength="1000"><%= product.description || '' %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn"><%= isEdit ? 'Save changes' : 'Create product' %></button>
      <a href="/products" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</main>

<%- include('../partials/footer') %>
